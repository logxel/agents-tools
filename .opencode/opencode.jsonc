{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "orchestrator",
  "agents": {
    "explore": {
      "disabled": false
    },
    "general": {
      "disabled": false
    }
  },
  "permissions": [
    {
      "action": "skill",
      "resource": "opencode-v2-workflow",
      "effect": "allow"
    }
  ]
}
